## Permet de définir des profils à utiliser par défaut en fonction des profils définis dans le docker-compose.yml :

# Liste des containers présent : 
# watchtower refine-alignements refbacon refhub refidref refmovies reforcid refperios refsudoc reftheses
COMPOSE_PROFILES=watchtower,refmovies


## Resources allocation

## REFALIGNEMENT
OPENREFINE_ALIGNEMENT_MEM_LIMIT=5g
OPENREFINE_ALIGNEMENT_CPU_LIMIT=5
OPENREFINE_ALIGNEMENT_PORT=13334
OPENREFINE_ALIGNEMENT_VERSION=3.8.6
OPENREFINE_ALIGNEMENT_REFINE_MEMORY=4600M

## REFBACON 
OPENREFINE_BACON_MEM_LIMIT=5g
OPENREFINE_BACON_CPU_LIMIT=5
OPENREFINE_BACON_PORT=13336
OPENREFINE_BACON_VERSION=3.8.7
OPENREFINE_BACON_REFINE_MEMORY=4600M

## REFHUB
OPENREFINE_HUB_MEM_LIMIT=5g
OPENREFINE_HUB_CPU_LIMIT=5
OPENREFINE_HUB_PORT=13337
OPENREFINE_HUB_VERSION=3.8.6
OPENREFINE_HUB_REFINE_MEMORY=4600M

## REFIDREF
OPENREFINE_IDREF_MEM_LIMIT=5g
OPENREFINE_IDREF_CPU_LIMIT=5
OPENREFINE_IDREF_PORT=13338
OPENREFINE_IDREF_VERSION=3.8.6
OPENREFINE_IDREF_REFINE_MEMORY=4600M

## REFMOVIES
OPENREFINE_MOVIES_MEM_LIMIT=5g
OPENREFINE_MOVIES_CPU_LIMIT=5
OPENREFINE_MOVIES_PORT=13341
OPENREFINE_MOVIES_VERSION=3.8.7
OPENREFINE_MOVIES_REFINE_MEMORY=4600M

## REFORCID
OPENREFINE_ORCID_MEM_LIMIT=5g
OPENREFINE_ORCID_CPU_LIMIT=5
OPENREFINE_ORCID_PORT=13340
OPENREFINE_ORCID_VERSION=3.8.6
OPENREFINE_ORCID_REFINE_MEMORY=4600M

## REFPERIOS
OPENREFINE_PERIOS_MEM_LIMIT=5g
OPENREFINE_PERIOS_CPU_LIMIT=5
OPENREFINE_PERIOS_PORT=13333
OPENREFINE_PERIOS_VERSION=3.8.6
OPENREFINE_PERIOS_REFINE_MEMORY=4600M

## REFSUDOC
OPENREFINE_SUDOC_MEM_LIMIT=5g
OPENREFINE_SUDOC_CPU_LIMIT=5
OPENREFINE_SUDOC_PORT=13339
OPENREFINE_SUDOC_VERSION=3.8.7
OPENREFINE_SUDOC_REFINE_MEMORY=4600M

## REFTHESES
OPENREFINE_THESES_MEM_LIMIT=5g
OPENREFINE_THESES_CPU_LIMIT=5
OPENREFINE_THESES_PORT=13340
OPENREFINE_THESES_VERSION=3.8.7
OPENREFINE_THESES_REFINE_MEMORY=4600M

## WATCHTOWER
OPENREFINE_WATCHTOWER_MEM_LIMIT=5g
OPENREFINE_WATCHTOWER_CPU_LIMIT=5
## WATCHTOWER

OPENREFINE_WATCHTOWER_RUN_ONCE=false
